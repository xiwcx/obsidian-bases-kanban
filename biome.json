{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 1,
		"lineWidth": 120
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"linter": {
		"enabled": false
	},
	"markdown": {
		"formatter": {
			"enabled": false
		}
	},
	"yaml": {
		"formatter": {
			"indentWidth": 2,
			"quoteStyle": "single"
		}
	},
	"files": {
		"includes": [
			"**",
			"!dist/**",
			"!node_modules/**",
			"!package-lock.json",
			"!.claude/**",
			"!.obsidian-cache/**",
			"!e2e-results/**"
		]
	}
}
