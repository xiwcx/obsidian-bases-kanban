{
	"compilerOptions": {
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2020",
		"allowJs": true,
		"strict": false,
		"noImplicitAny": true,
		"moduleResolution": "bundler",
		"importHelpers": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"lib": ["DOM", "ES5", "ES6", "ES7", "ES2020"]
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules", "e2e", ".claude"]
}
