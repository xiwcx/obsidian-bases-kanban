{
	"name": "kanban-bases-view",
	"version": "0.10.6",
	"private": true,
	"description": "A kanban-style drag-and-drop custom view for Obsidian Bases",
	"main": "main.js",
	"imports": {
		"obsidian": "./tests/mocks/obsidian.ts",
		"sortablejs": "./tests/mocks/sortablejs.js"
	},
	"scripts": {
		"changeset": "changeset",
		"changeset:check": "node scripts/check-changesets.mjs",
		"version": "node scripts/version.mjs",
		"versions:check": "node scripts/check-versions.mjs",
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"test": "NODE_NO_WARNINGS=1 tsx --tsconfig tsconfig.test.json --test tests/*.test.ts tests/*.test.mjs",
		"prepare": "git config core.hooksPath .githooks",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "biome format --write .",
		"format:check": "biome format --diagnostic-level=error ."
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"kanban",
		"bases",
		"task-management"
	],
	"author": "I. Welch Canavan",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.4.8",
		"@changesets/cli": "3.0.3",
		"@changesets/get-release-plan": "5.0.2",
		"@types/jsdom": "^21.1.6",
		"@types/node": "^24.0.0",
		"@types/sortablejs": "^1.15.9",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"esbuild": "^0.28.0",
		"eslint": "^9.0.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"jsdom": "^24.0.0",
		"obsidian": "^1.5.8",
		"tslib": "2.6.2",
		"tsx": "^4.20.6",
		"typescript": "5.3.3"
	},
	"dependencies": {
		"sortablejs": "^1.15.0"
	}
}
